# Anahtarsız açık Sentinel-2 erişimi için sır veya uydu hesabı gerekmez.
# NEXT_PUBLIC_ değerleri web çıktısında herkese açıktır; token/parola koymayın.
# Proje kökünden: cp .env.example web/.env.local

# Metadata tabanı: yerelde bu adresi, yayında kendi site adresinizi kullanın.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# İsteğe bağlı public HTTPS dosya kökü; verilmezse uygulama aynı GitHub kökünü kullanır.
# Kökün altında /data/monitoring/status.json ve ilişkili /data/... dosyaları bulunmalı.
# Uzak durum+aday çifti okunamazsa kaydedilmiş yerel durum+aday çifti kullanılır.
# Bu adres bir sır veya otomasyonun etkin olduğuna dair gösterge değildir.
NEXT_PUBLIC_MONITORING_BASE_URL=https://raw.githubusercontent.com/ztrkkgn/turkiye-doga-platform/main/web/public
